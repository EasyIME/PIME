<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="!(loc.ProductName)"
           Manufacturer="EasyIME"
           Version="$(var.ProductVersion)"
           ProductCode="$(var.ProductCode)"
           UpgradeCode="679BCFE7-E923-40D9-9051-5E4DF83EF12A"
           Scope="perMachine"
           Codepage="65001"
           Language="!(loc.LanguageId)">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" AllowSameVersionUpgrades="yes" Schedule="afterInstallValidate" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />

    <Property Id="NATIVE_ARCH">
      <RegistrySearch Id="NativeArchSearch" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64" />
    </Property>

    <Property Id="PIME_INSTALL_DIR">
      <RegistrySearch Id="PimeInstallDirSearch" Root="HKLM" Key="Software\PIME" Type="raw" />
    </Property>

    <Property Id="WIN10_BUILD">
      <RegistrySearch Id="Win10BuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuild" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WIN10_BUILD &gt;= 10240" Message="!(loc.OSNotSupported)" />

    <Property Id="LEGACY_NSIS_UNINSTALL_X86">
      <RegistrySearch Id="LegacyNsisSearchX86" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PIME" Name="UninstallString" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="LEGACY_NSIS_UNINSTALL_X64">
      <RegistrySearch Id="LegacyNsisSearchX64" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PIME" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    
    <Launch Condition="Installed OR (NOT LEGACY_NSIS_UNINSTALL_X86 AND NOT LEGACY_NSIS_UNINSTALL_X64)" Message="!(loc.LegacyNsisBlockMessage)" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <Property Id="WixShellExecTarget" Value="[#fil_PIMELauncher_exe]" />
    <CustomAction Id="CA_LaunchLauncher"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- Bypass LicenseAgreementDlg in the MSI -->
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="CA_LaunchLauncher" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    </UI>

    <!-- Directory Structure -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PIME">
        <Directory Id="X86DIR" Name="x86" />
        <Directory Id="X64DIR" Name="x64" />
        <Directory Id="ARM64DIR" Name="arm64" />
        <Directory Id="INSTALLFOLDER_PYTHON" Name="python">
          <Directory Id="INSTALLFOLDER_CINBASE" Name="cinbase" />
          <Directory Id="INSTALLFOLDER_PYTHON_IM" Name="input_methods">
            <Directory Id="INSTALLFOLDER_CHEWING" Name="chewing" />
            <Directory Id="INSTALLFOLDER_CHECJ" Name="checj" />
            <Directory Id="INSTALLFOLDER_CHELIU" Name="cheliu" />
            <Directory Id="INSTALLFOLDER_CHEARRAY" Name="chearray" />
            <Directory Id="INSTALLFOLDER_CHEDAYI" Name="chedayi" />
            <Directory Id="INSTALLFOLDER_CHEPINYIN" Name="chepinyin" />
            <Directory Id="INSTALLFOLDER_CHESIMPLEX" Name="chesimplex" />
            <Directory Id="INSTALLFOLDER_CHEPHONETIC" Name="chephonetic" />
            <Directory Id="INSTALLFOLDER_CHEEZ" Name="cheez" />
            <Directory Id="INSTALLFOLDER_CHEENG" Name="cheeng" />
            <Directory Id="INSTALLFOLDER_BRAILLE_CHEWING" Name="braille_chewing" />
            <Directory Id="INSTALLFOLDER_RIME" Name="rime" />
          </Directory>
        </Directory>
        
        <Directory Id="INSTALLFOLDER_NODE" Name="node">
          <Directory Id="INSTALLFOLDER_NODE_IM" Name="input_methods">
            <Directory Id="INSTALLFOLDER_MCBOPOMOFO" Name="McBopomofo" />
            <Directory Id="INSTALLFOLDER_MCFOXIM" Name="McFoxim" />
            <Directory Id="INSTALLFOLDER_MCTABIM" Name="McTabim" />
            <Directory Id="INSTALLFOLDER_EMOJIME" Name="emojime" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu Shortcuts Directory -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PIME" />
    </StandardDirectory>

    <!-- Features -->
    <Feature Id="Main" Title="!(loc.Feat_Main_Title)" Level="1" AllowAbsent="no" AllowAdvertise="no" Display="expand">
      <ComponentGroupRef Id="CoreBaseComponents" />
      <ComponentGroupRef Id="PythonBaseComponents" />
      <ComponentGroupRef Id="NodeBaseComponents" />
      <ComponentGroupRef Id="StartMenuComponents" />

      <!-- Python Input Methods Group -->
      <Feature Id="Feat_PythonGroup" Title="!(loc.Feat_PythonGroup_Title)" Level="1" AllowAdvertise="no">
        <Feature Id="Feat_Chewing" Title="!(loc.Feat_Chewing_Title)" Level="1" AllowAdvertise="no" Description="!(loc.Feat_Chewing_Desc)">
          <ComponentGroupRef Id="IM_Chewing" />
          <ComponentGroupRef Id="Shortcuts_Chewing" />
        </Feature>

        <Feature Id="Feat_CinGroup" Title="!(loc.Feat_CinGroup_Title)" Level="2" AllowAdvertise="no">
          <ComponentGroupRef Id="CinbaseBaseComponents" />

          <Feature Id="Feat_Checj" Title="!(loc.Feat_Checj_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Checj_Desc)">
            <ComponentGroupRef Id="IM_Checj" />
            <ComponentGroupRef Id="Shortcuts_Checj" />
          </Feature>

          <Feature Id="Feat_Cheliu" Title="!(loc.Feat_Cheliu_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Cheliu_Desc)">
            <ComponentGroupRef Id="IM_Cheliu" />
            <ComponentGroupRef Id="Shortcuts_Cheliu" />
          </Feature>

          <Feature Id="Feat_Chearray" Title="!(loc.Feat_Chearray_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Chearray_Desc)">
            <ComponentGroupRef Id="IM_Chearray" />
            <ComponentGroupRef Id="Shortcuts_Chearray" />
          </Feature>

          <Feature Id="Feat_Chedayi" Title="!(loc.Feat_Chedayi_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Chedayi_Desc)">
            <ComponentGroupRef Id="IM_Chedayi" />
            <ComponentGroupRef Id="Shortcuts_Chedayi" />
          </Feature>

          <Feature Id="Feat_Chepinyin" Title="!(loc.Feat_Chepinyin_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Chepinyin_Desc)">
            <ComponentGroupRef Id="IM_Chepinyin" />
            <ComponentGroupRef Id="Shortcuts_Chepinyin" />
          </Feature>

          <Feature Id="Feat_Chesimplex" Title="!(loc.Feat_Chesimplex_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Chesimplex_Desc)">
            <ComponentGroupRef Id="IM_Chesimplex" />
            <ComponentGroupRef Id="Shortcuts_Chesimplex" />
          </Feature>

          <Feature Id="Feat_Chephonetic" Title="!(loc.Feat_Chephonetic_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Chephonetic_Desc)">
            <ComponentGroupRef Id="IM_Chephonetic" />
            <ComponentGroupRef Id="Shortcuts_Chephonetic" />
          </Feature>

          <Feature Id="Feat_Cheez" Title="!(loc.Feat_Cheez_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Cheez_Desc)">
            <ComponentGroupRef Id="IM_Cheez" />
            <ComponentGroupRef Id="Shortcuts_Cheez" />
          </Feature>
        </Feature>

        <Feature Id="Feat_Cheeng" Title="!(loc.Feat_Cheeng_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Cheeng_Desc)">
          <ComponentGroupRef Id="IM_Cheeng" />
        </Feature>

        <Feature Id="Feat_BrailleChewing" Title="!(loc.Feat_BrailleChewing_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_BrailleChewing_Desc)">
          <ComponentGroupRef Id="IM_BrailleChewing" />
          <ComponentGroupRef Id="Shortcuts_BrailleChewing" />
        </Feature>

        <Feature Id="Feat_Rime" Title="!(loc.Feat_Rime_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Rime_Desc)">
          <ComponentGroupRef Id="IM_Rime" />
        </Feature>
      </Feature>

      <!-- Node Input Methods Group -->
      <Feature Id="Feat_NodeGroup" Title="!(loc.Feat_NodeGroup_Title)" Level="2" AllowAdvertise="no">
        <Feature Id="Feat_McBopomofo" Title="!(loc.Feat_McBopomofo_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_McBopomofo_Desc)">
          <ComponentGroupRef Id="IM_McBopomofo" />
        </Feature>

        <Feature Id="Feat_McFoxim" Title="!(loc.Feat_McFoxim_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_McFoxim_Desc)">
          <ComponentGroupRef Id="IM_McFoxim" />
        </Feature>

        <Feature Id="Feat_McTabim" Title="!(loc.Feat_McTabim_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_McTabim_Desc)">
          <ComponentGroupRef Id="IM_McTabim" />
        </Feature>

        <Feature Id="Feat_Emojime" Title="!(loc.Feat_Emojime_Title)" Level="2" AllowAdvertise="no" Description="!(loc.Feat_Emojime_Desc)">
          <ComponentGroupRef Id="IM_Emojime" />
        </Feature>
      </Feature>
    </Feature>

    <!-- Text Service Registration x86 -->
    <SetProperty Id="CA_Register_TS_x86" Value="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[X86DIR]PIMETextService.dll&quot;" Before="CA_Register_TS_x86" Sequence="execute" />
    <CustomAction Id="CA_Register_TS_x86" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="check" Impersonate="no" />
    
    <SetProperty Id="CA_Unregister_TS_x86" Value="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[X86DIR]PIMETextService.dll&quot;" Before="CA_Unregister_TS_x86" Sequence="execute" />
    <CustomAction Id="CA_Unregister_TS_x86" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="ignore" Impersonate="no" />

    <SetProperty Id="CA_Rollback_Register_TS_x86" Value="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[X86DIR]PIMETextService.dll&quot;" Before="CA_Rollback_Register_TS_x86" Sequence="execute" />
    <CustomAction Id="CA_Rollback_Register_TS_x86" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="rollback" Return="ignore" Impersonate="no" />

    <!-- Text Service Registration x64 -->
    <SetProperty Id="CA_Register_TS_x64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /s &quot;[X64DIR]PIMETextService.dll&quot;" Before="CA_Register_TS_x64" Sequence="execute" />
    <CustomAction Id="CA_Register_TS_x64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="check" Impersonate="no" />
    
    <SetProperty Id="CA_Unregister_TS_x64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /u /s &quot;[X64DIR]PIMETextService.dll&quot;" Before="CA_Unregister_TS_x64" Sequence="execute" />
    <CustomAction Id="CA_Unregister_TS_x64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="ignore" Impersonate="no" />

    <SetProperty Id="CA_Rollback_Register_TS_x64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /u /s &quot;[X64DIR]PIMETextService.dll&quot;" Before="CA_Rollback_Register_TS_x64" Sequence="execute" />
    <CustomAction Id="CA_Rollback_Register_TS_x64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="rollback" Return="ignore" Impersonate="no" />

    <!-- Text Service Registration arm64 -->
    <SetProperty Id="CA_Register_TS_arm64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /s &quot;[ARM64DIR]PIMETextService.dll&quot;" Before="CA_Register_TS_arm64" Sequence="execute" />
    <CustomAction Id="CA_Register_TS_arm64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="check" Impersonate="no" />
    
    <SetProperty Id="CA_Unregister_TS_arm64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /u /s &quot;[ARM64DIR]PIMETextService.dll&quot;" Before="CA_Unregister_TS_arm64" Sequence="execute" />
    <CustomAction Id="CA_Unregister_TS_arm64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="ignore" Impersonate="no" />

    <SetProperty Id="CA_Rollback_Register_TS_arm64" Value="&quot;[WindowsFolder]Sysnative\regsvr32.exe&quot; /u /s &quot;[ARM64DIR]PIMETextService.dll&quot;" Before="CA_Rollback_Register_TS_arm64" Sequence="execute" />
    <CustomAction Id="CA_Rollback_Register_TS_arm64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="rollback" Return="ignore" Impersonate="no" />

    <!-- Stop PIMELauncher in all sessions before removing files -->
    <SetProperty Id="CA_StopPIMELauncher" Value="&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM PIMELauncher.exe" Before="CA_StopPIMELauncher" Sequence="execute" />
    <CustomAction Id="CA_StopPIMELauncher" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Return="ignore" Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="CA_StopPIMELauncher" Before="RemoveFiles" Condition="Installed OR WIX_UPGRADE_DETECTED" />

      <Custom Action="CA_Unregister_TS_x86" Before="RemoveFiles" Condition="?cmp_PIMETextService_x86=3" />
      <Custom Action="CA_Unregister_TS_x64" Before="RemoveFiles" Condition="?cmp_PIMETextService_x64=3" />
      <Custom Action="CA_Unregister_TS_arm64" Before="RemoveFiles" Condition="?cmp_PIMETextService_arm64=3" />

      <Custom Action="CA_Rollback_Register_TS_x86" Before="CA_Register_TS_x86" Condition="$cmp_PIMETextService_x86=3" />
      <Custom Action="CA_Rollback_Register_TS_x64" Before="CA_Register_TS_x64" Condition="$cmp_PIMETextService_x64=3" />
      <Custom Action="CA_Rollback_Register_TS_arm64" Before="CA_Register_TS_arm64" Condition="$cmp_PIMETextService_arm64=3" />

      <Custom Action="CA_Register_TS_x86" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;) AND (?cmp_PIMETextService_x86=3 OR $cmp_PIMETextService_x86=3)" />
      <Custom Action="CA_Register_TS_x64" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;) AND (?cmp_PIMETextService_x64=3 OR $cmp_PIMETextService_x64=3)" />
      <Custom Action="CA_Register_TS_arm64" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;) AND (?cmp_PIMETextService_arm64=3 OR $cmp_PIMETextService_arm64=3)" />
    </InstallExecuteSequence>
  </Package>

  <!-- Core Base Components -->
  <Fragment>
    <ComponentGroup Id="CoreBaseComponents" Directory="INSTALLFOLDER">
      <Component Id="cmp_version_txt" Guid="A2B11CD1-213E-4DF7-9E11-20739BF01314">
        <File Id="fil_version_txt" Source="..\..\version.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_Cleanup_PIME_Folder" Guid="DAB2F1FE-5D12-4217-9102-13FA10915B3C">
        <util:RemoveFolderEx On="uninstall" Property="PIME_INSTALL_DIR" />
      </Component>
      <Component Id="cmp_backends_json" Guid="524B0223-956A-4FE4-BD21-6A79F9C07538">
        <File Id="fil_backends_json" Source="..\..\backends.json" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMELauncher_exe" Guid="C41BF65D-E87F-4B7C-A586-71A3770D5A38">
        <File Id="fil_PIMELauncher_exe" Source="..\..\build\PIMELauncher\PIMELauncher.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMELauncher_Run" Guid="53E4CDD1-213E-4DF7-9E11-20739BF01315">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="PIMELauncher" Value="&quot;[INSTALLFOLDER]PIMELauncher.exe&quot;" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="cmp_license_txt" Guid="A3B11CD1-213E-4DF7-9E11-20739BF01316">
        <File Id="fil_license_txt" Source="..\..\LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_lgpl_txt" Guid="A4B11CD1-213E-4DF7-9E11-20739BF01317">
        <File Id="fil_lgpl_txt" Source="..\..\LGPL-2.0.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_psf_txt" Guid="A5B11CD1-213E-4DF7-9E11-20739BF01318">
        <File Id="fil_psf_txt" Source="..\..\PSF.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_apache_txt" Guid="A6B11CD1-213E-4DF7-9E11-20739BF01319">
        <File Id="fil_apache_txt" Source="..\..\APACHE-2.0.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_authors_txt" Guid="A7B11CD1-213E-4DF7-9E11-20739BF01320">
        <File Id="fil_authors_txt" Source="..\..\AUTHORS.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIME_Registry" Guid="870EEA01-C03C-4384-9BAA-4CFB7110C489">
        <RegistryValue Root="HKLM" Key="Software\PIME" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMETextService_x86" Directory="X86DIR" Guid="0A82FE1D-3C62-4D39-BA8F-835A3DB72752">
        <File Id="fil_PIMETextService_x86" Source="..\..\build\PIMETextService\Release\PIMETextService.dll" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMETextService_x64" Directory="X64DIR" Guid="D2BC8E45-8B24-4B2E-80AC-371465BE81F9" Condition="NATIVE_ARCH=&quot;AMD64&quot;">
        <File Id="fil_PIMETextService_x64" Source="..\..\build64\PIMETextService\Release\PIMETextService.dll" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMETextService_arm64" Directory="ARM64DIR" Guid="D3D921EB-00AC-4355-87B7-E498BA6F0EB6" Condition="NATIVE_ARCH=&quot;ARM64&quot;">
        <File Id="fil_PIMETextService_arm64_fwd" Name="PIMETextService.dll" Source="..\..\build_arm64\PIMETextService\Release\PIMETextService_forwarder.dll" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMETextService_arm64_real" Directory="ARM64DIR" Guid="B4D921EB-00AC-4355-87B7-E498BA6F0EB7" Condition="NATIVE_ARCH=&quot;ARM64&quot;">
        <File Id="fil_PIMETextService_arm64_real" Name="PIMETextService_arm64.dll" Source="..\..\build_arm64\PIMETextService\Release\PIMETextService.dll" KeyPath="yes" />
      </Component>
      <Component Id="cmp_PIMETextService_x64_real" Directory="ARM64DIR" Guid="C5D921EB-00AC-4355-87B7-E498BA6F0EB8" Condition="NATIVE_ARCH=&quot;ARM64&quot;">
        <File Id="fil_PIMETextService_x64_real" Name="PIMETextService_x64.dll" Source="..\..\build64\PIMETextService\Release\PIMETextService.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu Directory and Shortcuts -->
    <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">
      <Component Id="cmp_StartMenuFolder" Guid="CE646A9E-3BA5-4A37-9759-4089947849D9">
        <RemoveFolder Id="CleanUpStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PIME\StartMenu" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Input Method Shortcuts -->
    <ComponentGroup Id="Shortcuts_Chewing" Directory="ApplicationProgramsFolder">
      <Component Id="cmp_Shortcut_Chewing_Config" Guid="D6BF6100-84E3-4B94-A1FD-15D84A478C37">
        <Shortcut Id="sc_Chewing_Config"
                  Name="!(loc.Shortcut_Chewing_Config)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CHEWING]config_tool.py&quot; config"
                  WorkingDirectory="INSTALLFOLDER_CHEWING"
                  Icon="ico_ch_set.ico" />
        <RegistryValue Root="HKCU" Key="Software\PIME\Shortcuts\Chewing" Name="Config" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="cmp_Shortcut_Chewing_Phrases" Guid="41870B1F-5079-4A73-BE94-0E812F96CE28">
        <Shortcut Id="sc_Chewing_Phrases"
                  Name="!(loc.Shortcut_Chewing_Phrases)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CHEWING]config_tool.py&quot; user_phrase_editor"
                  WorkingDirectory="INSTALLFOLDER_CHEWING"
                  Icon="ico_ch_phr.ico" />
        <RegistryValue Root="HKCU" Key="Software\PIME\Shortcuts\Chewing" Name="Phrases" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts_Checj" Directory="ApplicationProgramsFolder">
      <Component Id="cmp_Shortcut_Checj" Guid="3F8DE165-226D-44FD-A3DC-D6995646EB0F">
        <Shortcut Id="sc_Checj"
                  Name="!(loc.Shortcut_Checj)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CINBASE]configtool.py&quot; config checj"
                  WorkingDirectory="INSTALLFOLDER_CINBASE"
                  Icon="ico_checj.ico" />
        <RegistryValue Root="HKCU" Key="Software\PIME\Shortcuts\Checj" Name="Config" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts_Cheliu" Directory="ApplicationProgramsFolder">
      <Component Id="cmp_Shortcut_Cheliu" Guid="72449753-A444-4BC8-9FA6-56040FDF2749">
        <Shortcut Id="sc_Cheliu"
                  Name="!(loc.Shortcut_Cheliu)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CINBASE]configtool.py&quot; config cheliu"
                  WorkingDirectory="INSTALLFOLDER_CINBASE"
                  Icon="ico_cheliu.ico" />
        <Shortcut Id="sc_Cheliu_Import"
                  Name="!(loc.Shortcut_Cheliu_Import)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CINBASE]tools\import_liu.py&quot;"
                  WorkingDirectory="INSTALLFOLDER_CINBASE"
                  Icon="ico_cheliu.ico" />
        <RegistryValue Root="HKCU" Key="Software\PIME\Shortcuts\Cheliu" Name="Config" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts_Chearray" Directory="ApplicationProgramsFolder">
      <Component Id="cmp_Shortcut_Chearray" Guid="EA581895-B33D-4A2F-8097-4FF2C149C03C">
        <Shortcut Id="sc_Chearray"
                  Name="!(loc.Shortcut_Chearray)"
                  Target="[INSTALLFOLDER_PYTHON]python3\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER_CINBASE]configtool.py&quot; config chearray"
                  WorkingDirectory="INSTALLFOLDER_CINBASE"
                  Icon="ico_chearray.ico" />
        <RegistryValue Root="HKCU" Key="Software\PIME\Shortcuts\Chearray" Name="Config" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts_Chedayi" Directory="ApplicationProgramsFolder">
