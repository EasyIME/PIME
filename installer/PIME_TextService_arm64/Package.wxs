<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PIME Text Service (ARM64)" 
           Manufacturer="EasyIME" 
           Version="2.0.0.0" 
           UpgradeCode="BE995960-93A1-4DF5-B5E3-F5E4EAC57B18"
           Scope="perMachine">
    
    <MediaTemplate EmbedCab="yes" CabinetTemplate="tsarm_{0}.cab" />
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PIME">
        <Directory Id="ARM64DIR" Name="arm64" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="TextServiceComponents_arm64" />
    </Feature>



  <!-- Register COM / Text Service via native ARM64 regsvr32 during deferred commit/install -->
  <CustomAction Id="CA_RegisterTextService_arm64"
                Directory="System64Folder"
                ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[ARM64DIR]PIMETextService.dll&quot;"
                Execute="deferred"
                Impersonate="no"
                Return="check" />

  <CustomAction Id="CA_UnregisterTextService_arm64"
                Directory="System64Folder"
                ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[ARM64DIR]PIMETextService.dll&quot;"
                Execute="deferred"
                Impersonate="no"
                Return="ignore" />

  <InstallExecuteSequence>
    <Custom Action="CA_UnregisterTextService_arm64" Before="RemoveFiles" Condition="(NOT UPGRADINGPRODUCTCODE) AND (REMOVE=&quot;ALL&quot;)" />
    <Custom Action="CA_RegisterTextService_arm64" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
  </InstallExecuteSequence>
</Package>

  <Fragment>
    <ComponentGroup Id="TextServiceComponents_arm64" Directory="ARM64DIR">
      <Component Id="cmp_PIMETextService_arm64" Guid="D3D921EB-00AC-4355-87B7-E498BA6F0EB6" Bitness="always64">
        <File Id="fil_PIMETextService_arm64" Source="..\..\build_arm64\PIMETextService\Release\PIMETextService.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
