!ifndef PIME_INSTALLER_MACROS_NSH
!define PIME_INSTALLER_MACROS_NSH


; ==============================================================================
; Macro: CheckFileMD5Equal
; ------------------------------------------------------------------------------
; Compares the MD5 checksums of two files using the md5dll plugin.
;
; Parameters:
;   FILE_A   - Full path to first file.
;   FILE_B   - Full path to second file.
;   OUT_VAR  - Variable to store result: "True" if both files exist and have
;              matching checksums; "False" otherwise.
; ==============================================================================
!macro CheckFileMD5Equal FILE_A FILE_B OUT_VAR
    Push $R0
    Push $R1

    !define md5A    $R0
    !define md5B    $R1
    !define isMatch $R1 ; reuse R1 for result

    StrCpy ${isMatch} "False"
    ${If} ${FileExists} "${FILE_A}"
    ${AndIf} ${FileExists} "${FILE_B}"
        md5dll::GetMD5File "${FILE_A}"
        Pop ${md5A}
        md5dll::GetMD5File "${FILE_B}"
        Pop ${md5B}
        ${If} ${md5A} == ${md5B}
            StrCpy ${isMatch} "True"
        ${EndIf}
    ${EndIf}

    Push ${isMatch} ; push result onto stack

    !undef md5A
    !undef md5B
    !undef isMatch

    Exch 2
    Pop $R0
    Pop $R1
    Pop ${OUT_VAR}
!macroend


; ==============================================================================
; Macro: SafeDeleteFile
; ------------------------------------------------------------------------------
; Safely deletes an in-use binary file (DLL / EXE) during uninstallation or upgrade.
;
; Expected Behavior:
;   1. If target does not exist, does nothing.
;   2. Tries immediate deletion via Delete.
;   3. If target is in use / locked:
;      - Generates a unique temporary filename in the same directory.
;      - Attempts to rename TARGET_FILE to this unique temporary file.
;      - If rename succeeds: schedules only the temporary file for deletion on
;        reboot using Delete /REBOOTOK.
;      - If rename fails (hard lock): schedules original TARGET_FILE on reboot
;        and sets RebootFlag.
;
; Parameters:
;   TARGET_FILE - Path to file to delete.
; ==============================================================================
!macro SafeDeleteFile TARGET_FILE
    Push $R0
    Push $R1

    !define sdf_tempDeletedFile $R0
    !define sdf_targetDir       $R1

    ${If} ${FileExists} "${TARGET_FILE}"
        ClearErrors
        Delete "${TARGET_FILE}"
        ${If} ${Errors}
            ; In use: generate a unique temporary name in the same directory
            GetFullPathName ${sdf_targetDir} "${TARGET_FILE}\.."
            GetTempFileName ${sdf_tempDeletedFile} "${sdf_targetDir}"
            ; GetTempFileName creates a 0-byte file on disk to claim the name;
            ; delete it so it is not left behind as an empty orphaned file.
            Delete "${sdf_tempDeletedFile}"
            StrCpy ${sdf_tempDeletedFile} "${sdf_tempDeletedFile}.deleted"

            ClearErrors
            Rename "${TARGET_FILE}" "${sdf_tempDeletedFile}"
            ${IfNot} ${Errors}
                ; Renamed: schedule only the unique file for deletion on reboot
                Delete /REBOOTOK "${sdf_tempDeletedFile}"
            ${Else}
                ; Hard-locked: schedule original target on reboot
                Delete /REBOOTOK "${TARGET_FILE}"
                SetRebootFlag true
            ${EndIf}
        ${EndIf}
    ${EndIf}

    !undef sdf_tempDeletedFile
    !undef sdf_targetDir

    Pop $R1
    Pop $R0
!macroend


; ==============================================================================
; Macro: InstallOrSkip
; ------------------------------------------------------------------------------
; Installs a binary file (DLL / EXE) to a destination path, skipping the write
; if the target file already exists and has identical MD5 checksum.
;
; Expected Behavior:
;   1. Fast path: attempts direct CopyFiles. If target is not locked, this succeeds
;      immediately with 0 hash calculations.
;   2. Target is locked: calculates MD5 of both target and source.
;   3. If MD5 matches: cleanly skips overwriting the file.
;   4. If MD5 differs: calls SafeDeleteFile to safely rename the locked target
;      to a unique <temp>.deleted file, freeing the destination path so the new
;      file can be copied directly without requiring a reboot.
;   5. If SafeDeleteFile hit a hard lock (rename failed): fails cleanly and prompts
;      user to restart the computer.
;
; Parameters:
;   TARGET_FILE - Destination file path (e.g. "$INSTDIR\x86\PIMETextService.dll").
;   SOURCE_FILE - Source candidate file (e.g. "$PLUGINSDIR\PIMETextService_x86.dll").
; ==============================================================================
!macro InstallOrSkip TARGET_FILE SOURCE_FILE
    Push $R0
    Push $R1
    Push $R2

    !define ios_isMD5Equal      $R0
    !define ios_targetDir       $R1
    !define ios_priorRebootFlag $R2

    ; Save pre-existing RebootFlag state so we don't accidentally clear a reboot requested earlier
    StrCpy ${ios_priorRebootFlag} "0"
    ${If} ${RebootFlag}
        StrCpy ${ios_priorRebootFlag} "1"
    ${EndIf}

    ; Ensure parent directory exists
    GetFullPathName ${ios_targetDir} "${TARGET_FILE}\.."
    CreateDirectory "${ios_targetDir}"

    ; 1. Try unconditional write first (succeeds if file is new or not in use)
    ClearErrors
    CopyFiles /SILENT "${SOURCE_FILE}" "${TARGET_FILE}"
    ${If} ${Errors}
        ; 2. Write failed: target is locked / in use.
        ; Check MD5: if identical, we don't need to overwrite it! Skip cleanly.
        !insertmacro CheckFileMD5Equal "${TARGET_FILE}" "${SOURCE_FILE}" ${ios_isMD5Equal}
        ${If} ${ios_isMD5Equal} != "True"
            ; 3. Target is locked and MD5 differs: safely remove/rename the old file
            !insertmacro SafeDeleteFile "${TARGET_FILE}"
            ${IfNot} ${FileExists} "${TARGET_FILE}"
                ; Rename succeeded: path is now freed on disk, copy new file into place
                ClearErrors
                CopyFiles /SILENT "${SOURCE_FILE}" "${TARGET_FILE}"
                ${If} ${Errors}
                    ; Target write failed even after path was freed
                    SetRebootFlag true
                    MessageBox MB_YESNO|MB_ICONSTOP $(REBOOT_QUESTION) IDNO +2
                    Reboot
                    Quit
                ${Else}
                    ; Successfully replaced in place.
                    ; Delete /REBOOTOK on the renamed temporary file sets NSIS RebootFlag
                    ; internally. If no reboot was requested before this macro ran, clear
                    ; the flag so we don't prompt the user for an unnecessary reboot.
                    ${If} ${ios_priorRebootFlag} == "0"
                        SetRebootFlag false
                    ${EndIf}
                ${EndIf}
            ${Else}
                ; 4. Hard lock: rename failed, cannot replace target without reboot.
                MessageBox MB_YESNO|MB_ICONSTOP $(REBOOT_QUESTION) IDNO +2
                Reboot
                Quit
            ${EndIf}
        ${EndIf}
    ${EndIf}

    !undef ios_isMD5Equal
    !undef ios_targetDir
    !undef ios_priorRebootFlag

    Pop $R2
    Pop $R1
    Pop $R0
!macroend


; ==============================================================================
; Macro: RegisterTextService
; ------------------------------------------------------------------------------
; Registers a COM/TSF Text Service DLL using Windows regsvr32.exe.
;
; Why this is needed and why ARCH / DisableX64FSRedirection is required:
;   1. NSIS built-in RegDLL command cannot be used: it runs in-process inside the
;      32-bit installer, so it cannot load or register 64-bit DLLs.
;   2. regsvr32.exe is procedural, not declarative: it calls LoadLibraryEx to load
;      the DLL into its own process and invokes DllRegisterServer.
;   3. A 32-bit process can NEVER load a 64-bit DLL (and vice-versa). Attempting
;      to load a 64-bit DLL into a 32-bit process fails with ERROR_BAD_EXE_FORMAT
;      (0x800700c1), which regsvr32 /s would silently swallow.
;   4. Because the NSIS installer is an x86 (32-bit) process, Windows WOW64 file
;      redirection intercepts $SYSDIR (C:\Windows\System32) and redirects it to
;      C:\Windows\SysWOW64 (the 32-bit regsvr32.exe).
;   5. Therefore, when registering a 64-bit or ARM64 DLL (ARCH == "64"), we MUST
;      temporarily disable WOW64 file redirection via DisableX64FSRedirection so
;      that $SYSDIR\regsvr32.exe executes the real native 64-bit regsvr32.exe
;      from System32, ensuring the 64-bit DLL loads and writes to the native
;      64-bit registry.
;   6. When registering an x86 DLL (ARCH == "32"), normal redirection remains
;      active so the 32-bit regsvr32.exe from SysWOW64 runs, properly registering
;      the 32-bit COM server under WOW6432Node.
;
; Parameters:
;   ARCH     - "32" for x86 DLLs; "64" for x64 and ARM64 DLLs.
;   DLL_PATH - Full path to the DLL (e.g. "$INSTDIR\x86\PIMETextService.dll").
; ==============================================================================
!macro RegisterTextService ARCH DLL_PATH
    ${If} "${ARCH}" == "64"
        ${DisableX64FSRedirection}
        ExecWait '"$SYSDIR\regsvr32.exe" /s "${DLL_PATH}"'
        ${EnableX64FSRedirection}
    ${Else}
        ExecWait '"$SYSDIR\regsvr32.exe" /s "${DLL_PATH}"'
    ${EndIf}
!macroend


; ==============================================================================
; Macro: UnregisterTextService
; ------------------------------------------------------------------------------
; Unregisters a COM/TSF Text Service DLL using Windows regsvr32.exe /u.
;
; Follows the exact same architecture handling as RegisterTextService: disables
; WOW64 file redirection when ARCH == "64" to invoke native 64-bit regsvr32.exe,
; and leaves redirection active for 32-bit DLLs to invoke SysWOW64 regsvr32.exe.
;
; Parameters:
;   ARCH     - "32" for x86 DLLs; "64" for x64 and ARM64 DLLs.
;   DLL_PATH - Full path to the DLL.
; ==============================================================================
!macro UnregisterTextService ARCH DLL_PATH
    ${If} "${ARCH}" == "64"
        ${DisableX64FSRedirection}
        ExecWait '"$SYSDIR\regsvr32.exe" /u /s "${DLL_PATH}"'
        ${EnableX64FSRedirection}
    ${Else}
        ExecWait '"$SYSDIR\regsvr32.exe" /u /s "${DLL_PATH}"'
    ${EndIf}
!macroend


; ==============================================================================
; Macro: KillProcessByName
; ------------------------------------------------------------------------------
; Forcefully terminates all instances of a process by image name across all user
; sessions, including their child process trees, without displaying a console window.
;
; Parameters:
;   EXE_NAME - Image name of the process (e.g. "PIMELauncher.exe").
; ==============================================================================
!macro KillProcessByName EXE_NAME
    Push $0
    nsExec::Exec '"$SYSDIR\taskkill.exe" /F /IM "${EXE_NAME}" /T'
    Pop $0 ; discard taskkill exit code (128 if process not found)
    Pop $0 ; restore caller's $0
!macroend


; ==============================================================================
; Macro: StopPIMELauncher
; ------------------------------------------------------------------------------
; Stops all PIMELauncher instances and their child backend processes:
;   1. Requests graceful exit for the current user session via "/quit".
;   2. Forcefully terminates any remaining instances across all user sessions
;      and their child processes via KillProcessByName.
; ==============================================================================
!macro StopPIMELauncher
    ${If} ${FileExists} "$INSTDIR\PIMELauncher.exe"
        ExecWait '"$INSTDIR\PIMELauncher.exe" /quit'
        Sleep 500
    ${EndIf}
    !insertmacro KillProcessByName "PIMELauncher.exe"
!macroend


; ==============================================================================
; Macro: CleanPIMERegistry
; ------------------------------------------------------------------------------
; Cleans up all PIME registry keys: Add/Remove Programs uninstall key,
; Run auto-start key, and PIME configuration root key.
; ==============================================================================
!macro CleanPIMERegistry
    DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
    DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "PIMELauncher"
    DeleteRegKey HKLM "Software\PIME"
!macroend


; ==============================================================================
; Macro: CreateCinBaseShortcut
; ------------------------------------------------------------------------------
; Creates a Start Menu shortcut for configuring a CinBase-based input method
; module, if that input method's section was selected by the user.
;
; Parameters:
;   SECTION_ID  - Section symbol (e.g. ${checj}).
;   LINK_TITLE  - Localized shortcut title string (e.g. $(SET_CHECJ)).
;   MODULE_NAME - Subdirectory / module name in python\input_methods (e.g. "checj").
; ==============================================================================
!macro CreateCinBaseShortcut SECTION_ID LINK_TITLE MODULE_NAME
    ${If} ${SectionIsSelected} ${SECTION_ID}
        CreateShortCut "$SMPROGRAMS\$(PRODUCT_NAME)\${LINK_TITLE}.lnk" \
            "$INSTDIR\python\python3\pythonw.exe" \
            '"$INSTDIR\python\cinbase\configtool.py" config ${MODULE_NAME}' \
            "$INSTDIR\python\input_methods\${MODULE_NAME}\icon.ico" 0
    ${EndIf}
!macroend


; ==============================================================================
; Macro: DownloadAndInstallVCRedist
; ------------------------------------------------------------------------------
; Prompts the user, downloads Microsoft VC++ Redistributable runtime installer
; using the inetc plugin, runs it, and verifies that the required CRT libraries
; are now present.
;
; Parameters:
;   URL      - Download URL for the VC++ redistributable installer.
;   EXE_NAME - Local temporary filename (e.g. "vc_redist.x64.exe").
; ==============================================================================
!macro DownloadAndInstallVCRedist URL EXE_NAME
    Push $R0
    Push $0

    !define downloadStatus $R0
    !define exitCode       $0

    MessageBox MB_YESNO|MB_ICONQUESTION $(DOWNLOAD_VCREDIST_QUESTION) IDYES +2
        Abort
    inetc::get "${URL}" "$TEMP\${EXE_NAME}"
    Pop ${downloadStatus}
    ${If} ${downloadStatus} != "OK"
        MessageBox MB_ICONSTOP|MB_OK $(DOWNLOAD_VCREDIST_FAILED_MESSAGE)
        Abort
    ${EndIf}
    ExecWait "$TEMP\${EXE_NAME}" ${exitCode}
    ${IfNot} ${FileExists} "$SYSDIR\ucrtbase.dll"
    ${OrIfNot} ${FileExists} "$SYSDIR\msvcp140.dll"
        MessageBox MB_ICONSTOP|MB_OK $(INST_VCREDIST_FAILED_MESSAGE)
        ExecShell "open" "https://support.microsoft.com/en-us/kb/2999226"
        Abort
    ${EndIf}

    !undef downloadStatus
    !undef exitCode

    Pop $0
    Pop $R0
!macroend


; ==============================================================================
; Helper Macro: _ReadWideString
; ------------------------------------------------------------------------------
; Reads a null-terminated UTF-16LE wide string from a memory pointer into OUT_VAR.
;
; Parameters:
;   PTR     - Memory pointer to start of wide string.
;   OUT_VAR - Variable to receive the string.
; ==============================================================================
!macro _ReadWideString PTR OUT_VAR
    System::Call '*${PTR}(&w${NSIS_MAX_STRLEN} .s)'
    Pop ${OUT_VAR}
!macroend


; ==============================================================================
; Helper Macro: _ScanMultiSzBufferExact
; ------------------------------------------------------------------------------
; Scans a memory buffer containing REG_MULTI_SZ strings for an exact path match.
; Strips NT prefixes (\??\, *1\??\, etc.) by finding the drive letter before ":\".
;
; Parameters:
;   PTR_BUFFER  - Memory pointer to start of multi-sz string buffer.
;   BUF_SIZE    - Total buffer size in bytes.
;   TARGET_PATH - Exact path to match (case-insensitive).
;   OUT_FOUND   - Output variable set to "True" if found, "False" otherwise.
; ==============================================================================
!macro _ScanMultiSzBufferExact PTR_BUFFER BUF_SIZE TARGET_PATH OUT_FOUND
    Push $R0
    Push $R1
    Push $R2
    Push $R3
    Push $R4

    !define pCurrent   $R0
    !define pEnd       $R1
    !define entryStr   $R2
    !define matchFound $R3
    !define pColon     $R4

    StrCpy ${matchFound} "False"
    StrCpy ${pCurrent} ${PTR_BUFFER}
    IntOp ${pEnd} ${PTR_BUFFER} + ${BUF_SIZE}

    ${While} ${pCurrent} < ${pEnd}
        ; Read current null-terminated string from memory
        !insertmacro _ReadWideString ${pCurrent} ${entryStr}

        ; Empty string indicates either null target of a delete pair or double-null terminator
        ${If} ${entryStr} == ""
            IntOp ${pCurrent} ${pCurrent} + 2 ; skip wchar \0
            ${If} ${pCurrent} >= ${pEnd}
                ${Break}
            ${EndIf}
            !insertmacro _ReadWideString ${pCurrent} ${entryStr}
            ${If} ${entryStr} == ""
                ${Break} ; double-null indicates end of multi-sz list
            ${EndIf}
        ${EndIf}

        ; Strip NT prefix: find ":\" to locate drive letter inside pCurrent
        System::Call 'shlwapi::StrStrIW(p ${pCurrent}, w ":\") p .s'
        Pop ${pColon}

        ${If} ${pColon} != 0
            ; Drive letter is 1 wchar (2 bytes) before the colon
            IntOp ${pColon} ${pColon} - 2
            !insertmacro _ReadWideString ${pColon} ${entryStr}
        ${EndIf}

        ; Exact match comparison against TARGET_PATH
        ${If} ${entryStr} == '${TARGET_PATH}'
            StrCpy ${matchFound} "True"
            ${Break}
        ${EndIf}

        ; Advance pointer past current string: (lstrlenW(pCurrent) + 1) * sizeof(wchar_t)
        System::Call 'kernel32::lstrlenW(p ${pCurrent}) i .s'
        Pop ${entryStr}
        IntOp ${entryStr} ${entryStr} + 1
        IntOp ${entryStr} ${entryStr} * 2
        IntOp ${pCurrent} ${pCurrent} + ${entryStr}
    ${EndWhile}

    Push ${matchFound} ; result on stack

    !undef pCurrent
    !undef pEnd
    !undef entryStr
    !undef matchFound
    !undef pColon

    Exch 5
    Pop $R0
    Pop $R1
    Pop $R2
    Pop $R3
    Pop $R4
    Pop ${OUT_FOUND}
!macroend


; ==============================================================================
; Macro: CheckPendingFileRename
; ------------------------------------------------------------------------------
; Inspects HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\PendingFileRenameOperations
; for whether TARGET_PATH (e.g. "$INSTDIR") is scheduled for deletion upon reboot.
;
; Uses shlwapi::SHGetValueW to query and read the REG_MULTI_SZ value in one shot,
; avoiding manual registry key opening and closing.
;
; Parameters:
;   TARGET_PATH - Target directory path to match exactly (e.g. "$INSTDIR").
;   OUT_VAR     - Variable to receive result ("True" if found, "False" otherwise).
; ==============================================================================
!macro CheckPendingFileRename TARGET_PATH OUT_VAR
    Push $R0
    Push $R1
    Push $R2
    Push $R3

    !define err     $R0
    !define bufSize $R1
    !define pBuffer $R2
    !define pSize   $R3
    !define isFound $R0

    StrCpy ${isFound} "False"

    ; 1. Query required buffer size using shlwapi::SHGetValueW
    System::Call 'shlwapi::SHGetValueW(p 0x80000002, w "SYSTEM\CurrentControlSet\Control\Session Manager", w "PendingFileRenameOperations", p 0, p 0, *i .s) i .s'
    Pop ${err}
    Pop ${bufSize}

    ${If} ${err} == 0
    ${AndIf} ${bufSize} > 0
        ; 2. Allocate buffer and size DWORD
        System::Alloc ${bufSize}
        Pop ${pBuffer}
        ${If} ${pBuffer} != 0
            System::Alloc 4
            Pop ${pSize}
            ${If} ${pSize} != 0
                System::Call '*${pSize}(i ${bufSize})'
                ; 3. Read REG_MULTI_SZ data
                System::Call 'shlwapi::SHGetValueW(p 0x80000002, w "SYSTEM\CurrentControlSet\Control\Session Manager", w "PendingFileRenameOperations", p 0, p ${pBuffer}, p ${pSize}) i .s'
                Pop ${err}
                System::Free ${pSize}

                ${If} ${err} == 0
                    ; 4. Check for exact match against TARGET_PATH
                    !insertmacro _ScanMultiSzBufferExact ${pBuffer} ${bufSize} "${TARGET_PATH}" ${isFound}
                ${EndIf}
            ${EndIf}
            System::Free ${pBuffer}
        ${EndIf}
    ${EndIf}

    Push ${isFound}

    !undef err
    !undef bufSize
    !undef pBuffer
    !undef pSize
    !undef isFound

    Exch 4
    Pop $R0
    Pop $R1
    Pop $R2
    Pop $R3
    Pop ${OUT_VAR}
!macroend

!endif ; PIME_INSTALLER_MACROS_NSH
